{
  "expo": {
    "name": "Card Sage",
    "slug": "card-sage",
    "owner": "tarun-sdbs-team",
    "version": "1.0.0",
    "extra": {
      "eas": {
        "projectId": "6ca15afc-f2a9-44fc-aa7b-744b1912a118"
      }
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "updates": {
      "url": "https://u.expo.dev/6ca15afc-f2a9-44fc-aa7b-744b1912a118",
      "enabled": true,
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "in.cardsage.app",
      "permissions": ["android.permission.READ_SMS", "android.permission.RECEIVE_SMS"],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
